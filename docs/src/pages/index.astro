---
import { Code } from "astro:components";
import "starlight-theme-next/fonts/geist-sans/index.css";
import "starlight-theme-next/fonts/geist-mono/index.css";
// The same palette Starlight loads through customCss. This page renders outside
// the Starlight shell, so it has to ask for the tokens itself.
import "../styles/tokens.css";

// Astro's BASE_URL carries the configured `base` ("/benni") with a trailing
// slash. Strip it so the helper below never emits a doubled separator.
const root = import.meta.env.BASE_URL.replace(/\/$/, "");
const p = (slug: string) => `${root}/${slug}`;

const title = "Benni, the end-to-end typed Redis client for TypeScript";
const description =
  "The end-to-end typed Redis client for TypeScript: one API across Node, Bun, Deno, and the edge. Your declared types travel from write to read.";

const files = [
  {
    name: "schema.ts",
    note: "Plain TypeScript values. They create no keys and run no migrations.",
    code: `import { hash, json, kv, number, string } from "benni/schema";

type UserProfile = {
  name: string;
  score: number;
};

export const users = hash("user", {
  name: string(),
  score: number()
});

export const profiles = kv("profile", json<UserProfile>());`
  },
  {
    name: "redis.ts",
    note: "Bind once, export the handle. Swap this one import to change runtime.",
    code: `import { benni } from "benni";
import { node } from "benni/node";
import * as schema from "./schema";

const client = await node({
  url: process.env.REDIS_URL ?? "redis://127.0.0.1:6379"
});

export const redis = benni(client, { schema });`
  },
  {
    name: "app.ts",
    note: "Each store is reachable by its export name through redis.query.",
    code: `import { redis } from "./redis";

await redis.query.users.hset("42", { name: "Ada", score: 10 });

const user = await redis.query.users.hget("42");
//    ^? { name: string; score: number } | null

await redis.query.profiles.set("42", { name: "Ada", score: 10 }, {
  ttlSeconds: 3600
});

const rawKey = redis.query.users.key("42"); // "user:42"`
  }
];

const before = `const raw = await client.get("profile:42");
//    ^? string | null

const user = JSON.parse(raw!) as UserProfile;
// hand-cast. the compiler never checked it.`;

const after = `const user = await redis.query.profiles.get("42");
//    ^? UserProfile | null

// decoded by the declared codec.`;

const principles = [
  [
    "Command names stay",
    "<code>hgetall</code> runs <code>HGETALL</code>. A type layer, not a query language, so everything you know about Redis still applies."
  ],
  [
    "Schemas are values",
    "No CLI, no codegen, no generated files. Declaring a schema creates no keys and runs nothing."
  ],
  [
    "One round trip",
    "<code>hget</code> is a single <code>HMGET</code>, not a pipeline of <code>HGET</code>s. On the edge, one call never quietly becomes four."
  ],
  [
    "Nothing is hidden",
    "No lazy loading, no identity map. The key is yours through <code>.key(id)</code>, and <code>redis.raw</code> is always there."
  ],
  [
    "Nothing is silent",
    "An unexpected reply throws <code>ReplyShapeError</code> with the raw value attached. It never casts and moves on."
  ],
  [
    "Works with your validator",
    "Any Standard Schema validator, so Zod, Valibot, or ArkType, with zero added dependencies."
  ]
];

const runtimes = [
  ["Node.js", "benni/node", "node-redis, an optional peer dependency"],
  ["Node.js", "benni/ioredis", "Adopts an ioredis client you already have"],
  ["Bun", "benni/bun", "Bun's built-in Redis client, no extra package"],
  ["Deno", "benni/node", "npm:redis through Deno's npm compatibility"],
  ["Edge", "benni/upstash", "Zero-dependency HTTP adapter, nothing but fetch"]
];

const primitives = [
  [
    "queue()",
    "Built for model calls. Heartbeat leases so a ten-minute generation is ordinary, a resumable output stream per job, and cancellation that aborts the provider call instead of marking a row.",
    "primitives/queue/"
  ],
  [
    "cache()",
    "Read-through with stampede protection. Exactly one loader call per miss.",
    "primitives/cache/"
  ],
  [
    "ratelimit()",
    "An accurate sliding window, not a fixed bucket approximation. One atomic round trip per check.",
    "primitives/ratelimit/"
  ],
  [
    "lock()",
    "A correct distributed lock. Never frees a lock that expired and was re-acquired by another holder.",
    "primitives/lock/"
  ]
];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={p("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="text/plain" href={p("llms.txt")} title="LLMs.txt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>

  <body>
    <header class="nav">
      <div class="wrap nav-in">
        <a
          class="brand"
          href={p("")}
          title="A benni-choko, the small dish benni pigment was sold in"
        >
          {/* currentColor on purpose: this copy of the mark sits inside the page,
              so it can follow the brand token instead of repeating the hex. */}
          <svg class="mark" viewBox="0 0 64 64" width="24" height="24" aria-hidden="true">
            <path
              d="M13 29 a19 19 0 0 0 38 0"
              fill="none"
              stroke="currentColor"
              stroke-width="7"
              stroke-linecap="round"></path>
            <circle cx="32" cy="17" r="6" fill="currentColor"></circle>
          </svg>
          benni
        </a>
        <nav class="nav-links">
          <a class="hide-sm" href="#why">Why</a>
          <a class="hide-sm" href="#start">Quick start</a>
          <a href="#runtimes">Runtimes</a>
          <a href="#primitives">Primitives</a>
          <a href={p("getting-started/introduction/")}>Docs</a>
          <a
            class="gh"
            href="https://github.com/ChiChuRita/benni"
            aria-label="Benni on GitHub"
          >
            <svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      {/* Line breaks are set by hand. text-wrap: balance produces an evenly
          ragged headline at every width, which is exactly what it looks like. */}
      <h1>
        Typed Redis for TypeScript.<br />All the way back.
      </h1>
      <p class="lede">
        Declare your data model once with typed codecs, bind a client, and call
        methods named after the Redis commands they run. Your declared types
        travel from write to read, so replies come back as <b>your types</b>, not
        <code>string | null</code>.
      </p>
      <div class="actions">
        <a class="btn" href={p("getting-started/quick-start/")}>Quick start</a>
        <span class="cmd">
          <span><span class="p">$</span> npm install benni redis</span>
          <button class="icb" type="button" data-copy="npm install benni redis"
            >copy</button
          >
        </span>
        <a class="lnk" href={p("getting-started/why-benni/")}>Why Benni?</a>
      </div>

      {/* The round trip, as a spec table rather than an animated diagram: one
          value written, two clients reading it back. Crimson marks the reply
          that kept its declared type. */}
      <table class="trip">
        <tbody>
          <tr>
            <th scope="row">you write</th>
            <td colspan="2"
              ><code
                >profiles.set("42", &#123; name: "Ada", score: 10 &#125;)</code
              ></td
            >
          </tr>
          <tr>
            <th scope="row">a raw client returns</th>
            <td><code class="lost">string | null</code></td>
            <td class="note">plus a hand-cast the compiler never checked</td>
          </tr>
          <tr>
            <th scope="row">benni returns</th>
            <td><code class="kept">UserProfile</code></td>
            <td class="note">decoded by the codec you declared</td>
          </tr>
        </tbody>
      </table>

      <section id="why">
        <h2>They type the commands. Benni types your data.</h2>
        <p>
          <code>node-redis</code> and <code>ioredis</code> are already typed, but
          only at the command surface. A reply arrives as Redis's generic wire
          shape, so you re-parse it and hand it a cast that the compiler agrees to
          without checking. <b>That cast is where the bugs live.</b>
        </p>
        <div class="pair">
          <div class="panel">
            <p class="cap">A raw client. The type is lost at the edge.</p>
            <Code code={before} lang="ts" theme="github-dark" />
          </div>
          <div class="panel">
            <p class="cap">Benni. The type is carried through.</p>
            <Code code={after} lang="ts" theme="github-dark" />
          </div>
        </div>
      </section>

      <section id="start">
        <h2>Quick start</h2>
        <div class="panel">
          <div class="tabs" role="tablist" aria-label="Quick start">
            {
              files.map((f, i) => (
                <button
                  class="tab"
                  role="tab"
                  type="button"
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-controls={`pane-${i}`}
                  data-tab={i}
                >
                  {f.name}
                </button>
              ))
            }
          </div>
          {
            files.map((f, i) => (
              <div class="pane" id={`pane-${i}`} data-pane={i} hidden={i !== 0}>
                <Code code={f.code} lang="ts" theme="github-dark" />
                <p class="cap ft">{f.note}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2>A typed client, not an ORM.</h2>
        <p>
          It competes with raw client usage plus hand-rolled casts, not with an
          object mapper. The altitude is deliberate: command level, on purpose.
        </p>
        <dl>
          {
            principles.map(([term, body]) => (
              <div>
                <dt>{term}</dt>
                <dd set:html={body} />
              </div>
            ))
          }
        </dl>
      </section>

      <section id="runtimes">
        <h2>One core, thin adapters, the same typed API.</h2>
        <p>
          Redis in TypeScript is fragmented by runtime rather than by dialect. The
          adapter contract is four methods wide, which is what makes one portable
          API real. Already running ioredis? Hand Benni the instance you have. It
          shares that connection and closes only what it leased.
        </p>
        <div class="scroll">
          <table class="data">
            <thead>
              <tr>
                <th scope="col">Runtime</th>
                <th scope="col">Adapter</th>
                <th scope="col">Client</th>
              </tr>
            </thead>
            <tbody>
              {
                runtimes.map(([rt, adapter, note]) => (
                  <tr>
                    <td>{rt}</td>
                    <td><code>{adapter}</code></td>
                    <td class="note">{note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="small">
          Blocking commands, Pub/Sub subscribing, <code>WATCH</code> transactions,
          and sessions need a persistent connection. The HTTP adapter declines
          them rather than emulating them, and covers the whole typed surface
          otherwise.
        </p>
      </section>

      <section id="primitives">
        <h2>Batteries only for what is easy to get wrong.</h2>
        <p>
          Built on any adapter, edge included. Not a search engine, not an index
          manager.
        </p>
        <dl>
          {
            primitives.map(([name, body, slug]) => (
              <div>
                <dt><a href={p(slug)}><code>{name}</code></a></dt>
                <dd>{body}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="end">
        <h2>Your types should survive the round trip.</h2>
        <div class="actions">
          <span class="cmd">
            <span><span class="p">$</span> npm install benni redis</span>
            <button class="icb" type="button" data-copy="npm install benni redis"
              >copy</button
            >
          </span>
          <a class="lnk" href={p("getting-started/quick-start/")}
            >Read the quick start</a
          >
        </div>
      </section>

      <p class="gloss">
        <b>紅</b> <strong>benni</strong> <em>(n.)</em> the deep crimson pigment
        pressed from safflower. Which makes this the red Redis client. We named it
        twice, in two languages, and noticed far too late.
      </p>

      <footer>
        <span>Benni, the end-to-end typed Redis client for TypeScript</span>
        <span>MIT licensed</span>
      </footer>
    </main>

    <script>
      // Quick-start file switcher.
      const tabs = document.querySelectorAll<HTMLButtonElement>(".tab");
      const panes = document.querySelectorAll<HTMLElement>(".pane");
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const i = tab.dataset.tab;
          tabs.forEach((t) =>
            t.setAttribute("aria-selected", String(t.dataset.tab === i))
          );
          panes.forEach((pane) => {
            pane.hidden = pane.dataset.pane !== i;
          });
        });
      });

      // Copy buttons.
      document
        .querySelectorAll<HTMLButtonElement>("[data-copy]")
        .forEach((btn) => {
          btn.addEventListener("click", async () => {
            await navigator.clipboard.writeText(btn.dataset.copy ?? "");
            btn.textContent = "copied";
            setTimeout(() => {
              btn.textContent = "copy";
            }, 1600);
          });
        });
    </script>

    <style>
      /* The landing page is deliberately standalone: Starlight's shell is what
         the rest of the site uses, and this page is the one place that steps
         outside it. Every colour below is an alias for a token in tokens.css,
         which the docs load too, so the two cannot drift.

         Set like a technical document, not a landing page: one sans face, one
         mono face, a small radius, hairlines instead of cards, and no section
         chrome. Crimson appears only where a declared type survived, or where
         something is actionable. */
      :root {
        --bg: var(--benni-bg);
        --raise: var(--benni-surface);
        --rule: var(--benni-rule);
        --rule-2: var(--benni-rule-soft);
        --ink: var(--benni-ink);
        --ink-2: var(--benni-ink-2);
        --ink-3: var(--benni-ink-3);
        --brand: var(--benni-brand);
        --brand-text: var(--benni-brand-text);
        --brand-fg: var(--benni-brand-fg);
        --radius: var(--benni-radius);
        --sans: "Geist Sans", ui-sans-serif, system-ui, sans-serif;
        --mono: "Geist Mono", ui-monospace, "SF Mono", Menlo, monospace;
        color-scheme: dark;
      }

      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--sans);
        font-size: 16px;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      /* Wide enough that the side-by-side comparison holds a 50-character line
         of TypeScript without clipping. Prose is held to a readable measure by
         the ch caps below, not by this. */
      .wrap {
        max-width: 952px;
        margin: 0 auto;
        padding: 0 clamp(18px, 4vw, 30px);
      }
      a {
        color: inherit;
      }
      :focus-visible {
        outline: 2px solid var(--brand-text);
        outline-offset: 2px;
        border-radius: 2px;
      }
      code {
        font-family: var(--mono);
        font-size: 0.88em;
      }

      /* ---------- nav ---------- */
      .nav {
        border-bottom: 1px solid var(--rule);
        margin-bottom: clamp(40px, 7vw, 68px);
      }
      .nav-in {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        height: 64px;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 9px;
        font-weight: 600;
        text-decoration: none;
      }
      .brand .mark {
        color: var(--brand);
        display: block;
        flex: none;
      }
      .nav-links {
        display: flex;
        align-items: center;
        gap: clamp(12px, 2.4vw, 22px);
        font-size: 14px;
        color: var(--ink-2);
      }
      .nav-links a {
        text-decoration: none;
      }
      .nav-links a:hover {
        color: var(--ink);
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .gh {
        display: flex;
      }
      @media (max-width: 660px) {
        .nav-links .hide-sm {
          display: none;
        }
      }

      /* ---------- opening ---------- */
      h1 {
        font-size: clamp(27px, 3.5vw, 38px);
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.021em;
        margin: 0 0 18px;
      }
      .lede {
        font-size: 17px;
        color: var(--ink-2);
        max-width: 64ch;
        margin: 0 0 26px;
      }
      .lede b {
        color: var(--ink);
        font-weight: 500;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 14px;
        align-items: center;
      }
      .btn {
        font-size: 14.5px;
        font-weight: 500;
        border-radius: var(--radius);
        padding: 9px 15px;
        border: 1px solid var(--brand);
        background: var(--brand);
        color: var(--brand-fg);
        text-decoration: none;
      }
      .btn:hover {
        filter: brightness(1.08);
      }
      .lnk {
        font-size: 14.5px;
        color: var(--ink-2);
        text-underline-offset: 3px;
      }
      .lnk:hover {
        color: var(--ink);
      }
      .cmd {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: var(--mono);
        font-size: 13.5px;
        color: var(--ink-2);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        padding: 8px 8px 8px 13px;
      }
      .cmd .p {
        color: var(--ink-3);
      }
      .icb {
        background: transparent;
        border: 0;
        cursor: pointer;
        padding: 2px 4px;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--ink-3);
      }
      .icb:hover {
        color: var(--ink);
        text-decoration: underline;
      }

      /* ---------- the round trip ---------- */
      .trip {
        width: 100%;
        border-collapse: collapse;
        margin: clamp(34px, 5vw, 52px) 0 0;
        border-top: 1px solid var(--rule);
        border-bottom: 1px solid var(--rule);
      }
      .trip th,
      .trip td {
        text-align: left;
        vertical-align: baseline;
        padding: 13px 0;
        border-top: 1px solid var(--rule-2);
      }
      .trip tr:first-child th,
      .trip tr:first-child td {
        border-top: 0;
      }
      .trip th {
        width: 11.5em;
        padding-right: 20px;
        font-weight: 400;
        color: var(--ink-3);
        white-space: nowrap;
      }
      .trip td:first-of-type code {
        font-size: 15px;
      }
      .trip .lost {
        color: var(--ink-3);
        text-decoration: line-through;
        text-decoration-color: color-mix(in oklab, var(--ink-3) 55%, transparent);
      }
      .trip .kept {
        color: var(--brand-text);
      }
      .trip .note {
        padding-left: 22px;
        font-size: 13.5px;
        color: var(--ink-3);
      }
      @media (max-width: 660px) {
        .trip th,
        .trip td,
        .trip .note {
          display: block;
          width: auto;
          padding: 0;
          border: 0;
        }
        .trip tr {
          display: block;
          padding: 13px 0;
          border-top: 1px solid var(--rule-2);
        }
        .trip tr:first-child {
          border-top: 0;
        }
        .trip th {
          margin-bottom: 3px;
        }
      }

      /* ---------- sections ---------- */
      section {
        margin: clamp(44px, 6vw, 62px) 0;
      }
      h2 {
        font-size: 20.5px;
        font-weight: 600;
        line-height: 1.32;
        letter-spacing: -0.015em;
        margin: 0 0 10px;
      }
      section > p {
        color: var(--ink-2);
        max-width: 68ch;
        margin: 0 0 22px;
      }
      section > p b {
        color: var(--ink);
        font-weight: 500;
      }
      /* Selector matches `section > p` rather than out-specifying it with
         !important, which is how paddings between sections start cancelling. */
      section > p.small {
        font-size: 14px;
        margin: 18px 0 0;
      }
      /* Prose only, matching Starlight's `:not(pre) > code` rule. The type names
         in the round-trip table and the adapter paths are display values, not
         inline mentions, so they stay unchipped. */
      p code,
      dd code {
        background: var(--raise);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        padding: 0.5px 5px;
        color: var(--ink);
      }

      /* ---------- code panels ---------- */
      .panel {
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        overflow: hidden;
      }
      .cap {
        margin: 0;
        padding: 9px 14px;
        font-size: 13px;
        color: var(--ink-3);
        border-bottom: 1px solid var(--rule);
        background: var(--raise);
      }
      .cap.ft {
        border-bottom: 0;
        border-top: 1px solid var(--rule);
      }
      .panel :global(pre) {
        margin: 0;
        padding: 16px;
        overflow-x: auto;
        font-size: 13px;
        line-height: 1.7;
        background: var(--raise) !important;
      }
      .panel :global(code) {
        font-family: var(--mono);
      }
      .pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }
      @media (max-width: 780px) {
        .pair {
          grid-template-columns: 1fr;
        }
      }
      .tabs {
        display: flex;
        gap: 16px;
        padding: 0 14px;
        border-bottom: 1px solid var(--rule);
        background: var(--raise);
      }
      .tab {
        appearance: none;
        background: transparent;
        border: 0;
        border-bottom: 1px solid transparent;
        margin-bottom: -1px;
        cursor: pointer;
        font-family: var(--mono);
        font-size: 12.5px;
        color: var(--ink-3);
        padding: 10px 0;
      }
      .tab:hover {
        color: var(--ink-2);
      }
      .tab[aria-selected="true"] {
        color: var(--ink);
        border-bottom-color: var(--brand);
      }

      /* ---------- term lists ---------- */
      dl {
        margin: 0;
        border-top: 1px solid var(--rule);
      }
      dl div {
        display: grid;
        grid-template-columns: 13.5em minmax(0, 1fr);
        gap: 20px;
        padding: 14px 0;
        border-bottom: 1px solid var(--rule-2);
      }
      dl div:last-child {
        border-bottom: 1px solid var(--rule);
      }
      @media (max-width: 620px) {
        dl div {
          grid-template-columns: 1fr;
          gap: 4px;
        }
      }
      dt {
        font-weight: 500;
      }
      dt a {
        color: var(--brand-text);
        text-underline-offset: 3px;
      }
      dd {
        margin: 0;
        color: var(--ink-2);
        font-size: 14.5px;
      }

      /* ---------- data table ---------- */
      .scroll {
        overflow-x: auto;
      }
      table.data {
        width: 100%;
        border-collapse: collapse;
        font-size: 14.5px;
        min-width: 500px;
      }
      table.data th,
      table.data td {
        text-align: left;
        padding: 11px 20px 11px 0;
        border-bottom: 1px solid var(--rule-2);
        vertical-align: baseline;
      }
      table.data thead th {
        font-weight: 500;
        font-size: 13.5px;
        color: var(--ink-3);
        border-bottom: 1px solid var(--rule);
      }
      table.data tbody tr:last-child td {
        border-bottom: 1px solid var(--rule);
      }
      .note {
        color: var(--ink-3);
      }

      /* ---------- closing ---------- */
      .end {
        margin-bottom: clamp(40px, 6vw, 56px);
      }
      .end h2 {
        margin-bottom: 18px;
      }
      .gloss {
        border-top: 1px solid var(--rule);
        padding: 20px 0 0;
        margin: 0;
        font-size: 14px;
        color: var(--ink-3);
        max-width: 68ch;
      }
      .gloss b {
        color: var(--brand-text);
        font-weight: 400;
        font-size: 16px;
      }
      .gloss strong {
        color: var(--ink-2);
        font-weight: 500;
      }
      .gloss em {
        font-style: italic;
      }
      footer {
        padding: 18px 0 40px;
        display: flex;
        flex-wrap: wrap;
        gap: 6px 22px;
        font-size: 13.5px;
        color: var(--ink-3);
      }
    </style>
  </body>
</html>
